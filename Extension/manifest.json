{
  "manifest_version": 3,
  "name": "ANTI-WebClass",
  "version": "0.4.1",
  "description": "Improve WebClass UX/UI.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "identity",
    "alarms",
    "notifications"
  ],
  "optional_permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://kulms.kanagawa-u.ac.jp/*",
    "https://api.github.com/*",
    "https://ticktick.com/*",
    "https://api.ticktick.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kulms.kanagawa-u.ac.jp/webclass/login.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/?acs_=*",
        "http://127.0.0.1/webclass/login.php*",
        "http://localhost/webclass/login.php*",
        "http://127.0.0.1/webclass/?acs_=*",
        "http://localhost/webclass/?acs_=*"
      ],
      "js": ["src/shared.js", "src/login.js"]
    },
    {
      "matches": [
        "https://kulms.kanagawa-u.ac.jp/webclass/*",
        "http://127.0.0.1/webclass/*",
        "http://localhost/webclass/*"
      ],
      "js": [
        "src/shared.js",
        "src/ui/components.js",
        "src/course-entry.js",
        "src/shortcuts.js"
      ],
      "css": [
        "src/styles/ui-tokens.css",
        "src/styles/ui-primitives.css",
        "src/styles/course-entry.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kulms.kanagawa-u.ac.jp/webclass/index.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/",
        "https://kulms.kanagawa-u.ac.jp/webclass/?*",
        "http://127.0.0.1/webclass/index.php*",
        "http://localhost/webclass/index.php*",
        "http://127.0.0.1/webclass/",
        "http://127.0.0.1/webclass/?*",
        "http://localhost/webclass/",
        "http://localhost/webclass/?*"
      ],
      "js": [
        "src/shared.js",
        "src/ui/components.js",
        "lib/flatpickr.min.js",
        "lib/ja.js",
        "lib/mobile-select.js",
        "src/scraper.js",
        "src/home/core.js",
        "src/home/course-navigation.js",
        "src/home/timetable.js",
        "src/home/data.js",
        "src/home/debug-todos.js",
        "src/home/messages.js",
        "src/home/todo-controls.js",
        "src/home/todo.js",
        "src/home/course-names.js",
        "src/home/settings-overlay.js",
        "src/home/dashboard.js",
        "src/home.js"
      ],
      "all_frames": true,
      "css": [
        "lib/flatpickr.min.css",
        "lib/mobile-select.css",
        "src/styles/flatpickr-custom.css",
        "src/styles/mobile-select-custom.css",
        "src/styles/home.css",
        "src/styles/home-messages.css",
        "src/styles/home-settings.css"
      ]
    },
    {
      "matches": [
        "https://kulms.kanagawa-u.ac.jp/webclass/course.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/do_contents.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/txtbk_frame.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/txtbk_show_chapter.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/txtbk_show_text.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/title_simple.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/qstn_frame.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/dqstn_button.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/dqstn_question.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/dqstn_answer.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/dqstn_answer_all.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/reslt_description.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/loadit.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/file_down.php*",
        "http://127.0.0.1/webclass/course.php*",
        "http://localhost/webclass/course.php*",
        "http://127.0.0.1/webclass/do_contents.php*",
        "http://localhost/webclass/do_contents.php*",
        "http://127.0.0.1/webclass/txtbk_frame.php*",
        "http://localhost/webclass/txtbk_frame.php*",
        "http://127.0.0.1/webclass/txtbk_show_chapter.php*",
        "http://localhost/webclass/txtbk_show_chapter.php*",
        "http://127.0.0.1/webclass/txtbk_show_text.php*",
        "http://localhost/webclass/txtbk_show_text.php*",
        "http://127.0.0.1/webclass/title_simple.php*",
        "http://localhost/webclass/title_simple.php*",
        "http://127.0.0.1/webclass/qstn_frame.php*",
        "http://localhost/webclass/qstn_frame.php*",
        "http://127.0.0.1/webclass/dqstn_button.php*",
        "http://localhost/webclass/dqstn_button.php*",
        "http://127.0.0.1/webclass/dqstn_question.php*",
        "http://localhost/webclass/dqstn_question.php*",
        "http://127.0.0.1/webclass/dqstn_answer.php*",
        "http://localhost/webclass/dqstn_answer.php*",
        "http://127.0.0.1/webclass/dqstn_answer_all.php*",
        "http://localhost/webclass/dqstn_answer_all.php*",
        "http://127.0.0.1/webclass/reslt_description.php*",
        "http://localhost/webclass/reslt_description.php*",
        "http://127.0.0.1/webclass/loadit.php*",
        "http://localhost/webclass/loadit.php*",
        "http://127.0.0.1/webclass/file_down.php*",
        "http://localhost/webclass/file_down.php*"
      ],
      "js": [
        "src/shared.js",
        "src/ui/components.js",
        "lib/mux-mp4.min.js",
        "src/course/core.js",
        "src/course/messages-overlay.js",
        "src/course/downloads.js",
        "src/course/shiryou-display.js",
        "src/course/shiken-layout.js",
        "src/course/shiken-single-page.js",
        "src/course/shiken-controls.js",
        "src/course/shiken-navigation.js",
        "src/course/shiken-one-by-one.js",
        "src/course/shiken-frames.js",
        "src/course/shiken-answer.js",
        "src/course/video-fullscreen.js",
        "src/course/media.js",
        "src/course/shiryou-shell.js",
        "src/course/shiryou-navigation.js",
        "src/course/shiryou-chapter.js",
        "src/course/course-quick-nav.js",
        "src/course/course-scroll-memory.js",
        "src/course/course-contents.js",
        "src/course.js"
      ],
      "css": [
        "src/styles/ui-tokens.css",
        "src/styles/ui-primitives.css",
        "src/styles/download.css",
        "src/styles/material.css",
        "src/styles/exam.css",
        "src/styles/course-messages.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kulms.kanagawa-u.ac.jp/webclass/txtbk_frame.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/txtbk_show_chapter.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/txtbk_show_text.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/title_simple.php*",
        "https://kulms.kanagawa-u.ac.jp/webclass/loadit.php*",
        "http://127.0.0.1/webclass/txtbk_frame.php*",
        "http://localhost/webclass/txtbk_frame.php*",
        "http://127.0.0.1/webclass/txtbk_show_chapter.php*",
        "http://localhost/webclass/txtbk_show_chapter.php*",
        "http://127.0.0.1/webclass/txtbk_show_text.php*",
        "http://localhost/webclass/txtbk_show_text.php*",
        "http://127.0.0.1/webclass/title_simple.php*",
        "http://localhost/webclass/title_simple.php*",
        "http://127.0.0.1/webclass/loadit.php*",
        "http://localhost/webclass/loadit.php*"
      ],
      "js": ["src/beforeunload-blocker.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/beforeunload-blocker.js",
        "lib/mp4box.all.js",
        "src/options.html"
      ],
      "matches": [
        "https://kulms.kanagawa-u.ac.jp/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ANTI-WebClass settings",
    "default_popup": "src/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
